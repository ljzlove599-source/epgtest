name: convert guangdong 
on:
  schedule:
    - cron: "7 */1 * * *"  # 每小时运行一次
  workflow_dispatch:       # 支持手动触发

jobs:
  download-convert-epg:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout the repo
        uses: actions/checkout@v3
        with:
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Install Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.x'

      - name: Install requirements (if any)
        run: |
          pip install -r requirements.txt || true

      - name: Download XML.GZ file
        run: |
          curl -L -o epgguangdong.xml.gz https://raw.githubusercontent.com/litiande03/epg/refs/heads/master/pl.xml.gz

      - name: Decompress XML.GZ
        run: |
          gunzip -f epgguangdong.xml.gz || echo "解压完成或文件不存在"

      - name: Run Conversion Script
        run: |
          # 检查文件是否存在
          if [ -f "epgguangdong.xml" ]; then
            python convert.py epgguangdong.xml
          else
            echo "错误: epgguangdong.xml 文件不存在"
            exit 1
          fi

      - name: Clean up temporary files
        run: |
          # 删除临时文件，只保留需要的文件
          rm -f epgguangdong.xml.gz epgguangdong.xml || true

      - name: Commit and push changes
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          
          # 检查是否有文件变化
          if git diff --quiet && git diff --staged --quiet; then
            echo "没有文件变化，跳过提交"
            exit 0
          fi
          
          # 拉取最新更改
          git pull origin main --no-rebase
          
          # 添加文件并提交
          git add .
          git commit -m "Auto update EPG and convert XML [$(date +'%Y-%m-%d %H:%M:%S UTC')]"
          git push
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
