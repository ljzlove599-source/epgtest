name: Fetch YouTube Live M3U8 URL

on:
  schedule:
    - cron: '0 * * * *'  # Runs every hour; adjust as needed
  workflow_dispatch:   # Allows manual trigger

jobs:
  fetch-m3u8:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests

      - name: Run Python script to fetch M3U8
        run: |
          python yt.py
        env:
          YOUTUBE_URL: 'https://youtube.com/live/fN9uYWCjQaw'  # Replace with your URL if needed

      - name: Commit and push changes (optional, e.g., save M3U8 to a file)
        if: success()
        run: |
          git config --global user.name 'GitHub Actions'
          git config --global user.email 'actions@github.com'
          git add m3u8_url.txt  # Assuming the script outputs to this file
          git commit -m 'Update M3U8 URL' || echo "No changes to commit"
          git push
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
